rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /pins/{pinId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn()
                    && (resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isSignedIn()
                    && (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /meta/{docId} {
      allow read, write: if isSignedIn();
    }

    match /admins/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // メール→表示名の対応。手動でdoc追加運用（doc ID=メール, field name）。
    // 読み取りのみ許可。クライアントからの改変は不可。
    match /displayNames/{email} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // 調査周回マスタ（survey_rounds）。doc ID=`${branch}__${areaCode}`（areaCode=JIS5桁市区町村コード。例 "名古屋__23208"＝津島市）。
    //   read=ログイン全員（現場/管理が現在周回を参照）。write=管理者のみ（周回開始・リセット＝管理操作・C-2で使用）。
    //   マスタ無エリアは currentRound=1 扱い（クライアント側フォールバック）。
    match /survey_rounds/{roundId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // ───────────────────────────────────────────────────────────────
    // 調査グリッド進捗（survey_grids）。doc ID = "G_{row}_{col}"（index.html toggleGridCell）。
    //   書込構造と一致を検証済み：create時 surveyedBy = currentUser.email（= token.email）。
    //   解除(delete)は本人 or admin 限定。update は所有者/admin かつ surveyedBy 不変（なりすまし防止）。
    //   ※コメントアウト時は該当パスがデフォルトdeny＝グリッド保存失敗の原因。単独deployで有効化。
    match /survey_grids/{gridId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.surveyedBy == request.auth.token.email;
      allow update: if isSignedIn()
                    && (resource.data.surveyedBy == request.auth.token.email || isAdmin())
                    && request.resource.data.surveyedBy == resource.data.surveyedBy;
      allow delete: if isSignedIn()
                    && (resource.data.surveyedBy == request.auth.token.email || isAdmin());
    }
    // ───────────────────────────────────────────────────────────────

    // ───────────────────────────────────────────────────────────────
    // 勤怠打刻（attendance・K便 K-1）。doc ID = `${branch}__${email}__${YYYY-MM-DD}`（date は JST）。
    //   事務所のタイムカードを index.html の「開始／終了」チップに置き換える第1段。
    //   K-1 が持つのは打刻2つ（開始・終了）だけ。休憩・修正UIは K-2、給与計算/Excel は K-3。
    //   データ構造と経緯は docs/attendance-design.md。
    //
    //   read   : 本人（メール一致）または管理者。
    //            ※ 本人は自分の doc を getDoc するだけで、list（クエリ）は投げない。
    //              メール一致条件は list では docごとに評価できないため、一覧を引けるのは admin だけ。
    //   create : 打刻できるのは調査員アカウントのみ（isSurveyor）。当日(JST)・自分のメール・inAt だけ。
    //   update : 本人は「outAt がまだ null のときに outAt を1回だけ入れる」のみ。
    //            触れてよいのは outAt / outLoc / updatedAt の3つだけ＝inAt・date・email・branch は不変。
    //            admin は全フィールド可（打刻忘れの修正＝K-2）。
    //   delete : K-1 の間だけ admin に許す（本番で行うテスト打刻の後始末用）。
    //            ★K-2 で修正UI（理由必須・履歴 corrections）が入った時点で `if false` に戻すこと。
    //
    //   時刻は必ず serverTimestamp()。端末時計は使わせない（request.time との一致で構造的に強制する）。
    match /attendance/{docId} {
      // JSTの「今日」(YYYY-MM-DD)。rules に日付整形が無いので +9h してから桁を組み立てる。
      function jstNow()   { return request.time + duration.value(9, 'h'); }
      function pad2(n)    { return n < 10 ? '0' + string(n) : string(n); }
      function todayJst() {
        return string(jstNow().year()) + '-' + pad2(jstNow().month()) + '-' + pad2(jstNow().day());
      }

      // 打刻できる人＝調査員（K-1 の暫定判定）。
      //   @hm.com / @kyoto-hm.com のうち、営業共有アカウントを個別に除外する。
      //   事務・営業・管理（@housemarket.com / @kyoto.com / @nagoya.com）はドメインで落ちる。
      //   ※ K-3 で staff マスタができたら「staff/{email} に登録がある人」判定へ切り替え、
      //     このメール判定は削除する（ドメインの増減を rules 改訂で追いかけない）。
      //   ※ index.html 側の canPunch() と同じ条件。片方だけ変えないこと。
      function isSurveyor() {
        return request.auth.token.email.matches('.*@(hm|kyoto-hm)\\.com')
               && !(request.auth.token.email in ['kyotoman@kyoto-hm.com']);
      }

      allow read: if isSignedIn()
                  && (resource.data.email == request.auth.token.email || isAdmin());

      allow create: if isSignedIn()
                    && isSurveyor()
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.date  == todayJst()
                    && docId == request.resource.data.branch + '__'
                              + request.resource.data.email  + '__'
                              + request.resource.data.date
                    && request.resource.data.inAt  == request.time   // serverTimestamp() 以外を弾く
                    && request.resource.data.outAt == null;          // 開始時点で終了は入れさせない

      allow update: if isSignedIn()
                    && (isAdmin() || (
                         resource.data.email == request.auth.token.email
                      && resource.data.outAt == null                 // 二重終了は rules 側でも止める
                      && request.resource.data.outAt == request.time // serverTimestamp() 以外を弾く
                      && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['outAt', 'outLoc', 'updatedAt'])
                    ));

      allow delete: if isAdmin();
    }

    // 社員マスタ（staff）。doc ID = メールアドレス。
    //   K-1 では読むだけ（勤怠一覧の氏名表示に使い、未登録なら displayNames の name へフォールバック）。
    //   登録・時給等の項目追加は K-3。書き込みは管理者のみ。
    match /staff/{email} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // 公図取得済みマーク（kouzu_marks）。法務局/登記情報提供サービスで公図を取得した地点の記録。
    //   二重取得の防止が目的。read も isAdmin にすることで調査員(index.html)からは購読しても読めない
    //   ＝完全に管理者専用。公図ファイル本体は保持しない（マークとメタ情報のみ）。
    match /kouzu_marks/{markId} {
      allow read:   if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ───────────────────────────────────────────────────────────────
    // 行政界ポリゴン（areaPolygons）。doc ID = ZENRIN の address_code（大字OAZ＝8桁。例 "23114001"）。
    //   周回機能で「エリア＝大字」を面として扱うための、ゼンリン住所検索APIの取得結果キャッシュ。
    //   中身は公開の地図データのみで、個人情報も自社の営業情報も含まない。
    //
    //   【設計上の制約：ここは純キャッシュ】
    //     周回ステータス・調査進捗・担当者といった運用データを、このコレクションに同居させないこと。
    //     取込は「区ごとに全件を setDoc で上書き」する破壊的更新なので、運用データを持たせると
    //     再取込のたびに消える。周回まわりの状態は survey_rounds 側に置く。
    //     （同じ制約を admin.html の書き込み箇所にも記載している）
    //
    //   read  = ログイン全員（将来 index.html 側でも面を描くため。管理者限定にしない）
    //   write = 管理者のみ（取込は admin.html の管理操作＝周回管理と同じ権限境界）
    match /areaPolygons/{addressCode} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // 行政界ポリゴンの索引（areaPolygonIndex）。doc ID = "shk"（市区町村界の索引・1docのみ）。
    //   中身は { codes: { "23114": {name, minLat, maxLat, minLng, maxLng, pointCount} , ... } }。
    //   index.html は「表示範囲に入る市区町村」をこの索引の bbox だけで判定し、
    //   交差した市区の areaPolygons/{code} だけを getDoc する（全件は読まない）。
    //   これも areaPolygons と同じ純キャッシュで、取込のたびに全SHK docから作り直して上書きする。
    //   運用データを置かないこと（再取込で消える）。
    //   read/write の境界は areaPolygons と揃える（読み＝ログイン全員／書き＝管理者のみ）。
    match /areaPolygonIndex/{docId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }
    // ───────────────────────────────────────────────────────────────
  }
}
