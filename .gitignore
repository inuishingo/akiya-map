# Claude Code local memory (not shared)
memory/

# 検証用の一時ファイル置き場（APIサンプル・回収したソース等。コミットしない）
tmp/

# Claude Code のローカル設定
.claude/

# Cloud Functions の依存パッケージ（deploy時に自動インストールされる）
functions/node_modules/
functions/.env
firebase-debug.log

# Firebase エミュレータが吐くログ（ローカル実行の副産物。コミットしない）
firestore-debug.log
ui-debug.log
pglite-debug.log
dataconnect-debug.log

# ルールのデプロイ時バックアップ（scripts/deploy-rules.mjs が作る）
firestore.rules.*.bak

# ルート package.json は依存ゼロだが、npm i を打った場合に備えて
/node_modules/

# 本番接続固定の確認用コピー（npm run prod-preview が作る。確認が終わったら消す）
admin.prod.html

# 認証情報を含む運用スクリプト（追跡しない）
scripts/
scripts/__pycache__/

# 勤怠K便の設計メモ。従業員の待遇（時給・通勤手当）と実名を扱う前提の文書なので
# public リポジトリには置かない。設計書はプロジェクト側で管理する。
# ※docs/ ごとは無視しない（公開してよい資料を将来ここに置くため）。
docs/attendance-design.md

# ローカルの作業ファイル（追跡しない）
# firestore.rules.bak は上の firestore.rules.*.bak に一致しない（中間セグメントが無い）ため個別指定。
firestore.rules.bak
index.mock.html
inspect_lines.py
validate_script.py
